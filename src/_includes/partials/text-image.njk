{#
  A feature section: the copy in a card next to a screenshot or a visual.
  Data: home.featureSections (see _data/home.js). `text`, `points` and the
  callout text may contain inline HTML (links to other sections, <b>, <code>).
#}
<section class="text-image | section {{ "bg-white" if section.bg === 'white' }}"{% if section.id %} id="{{ section.id }}"{% endif %}>
  <div class="wrapper | text-image__content {{ 'text-image__content--reverse' if reverse }}">
    <div class="text-image__copy">
      <h1 class="text-xl lg:text-2xl weight-ultrabold">{{ section.headline }}</h1>
      <p class="lg:text-md text-gray-2">{{ section.text | safe }}</p>

      {%- if section.points %}
        <ul class="text-image__points" role="list">
          {%- for point in section.points %}
          <li>{{ point | safe }}</li>
          {%- endfor %}
        </ul>
      {%- endif %}

      {%- if section.callout %}
        <p class="text-image__callout"><strong>{{ section.callout.title }}</strong> {{ section.callout.text | safe }}</p>
      {%- endif %}

      {% if section.painpoint %}
        <p class="text-image__painpoint">{{ section.painpoint }}</p>
      {% endif %}

      {%- if section.links -%}
        <div class="cluster pt-xs" style="--cluster-gap: var(--space-2xs)">
          {%- for link in section.links -%}
            <a
              href="{{ link.url }}"
              class="button {{ 'button--primary' if loop.index0 === 0 else 'button--secondary' }}"
              {{ "rel='noopener noreferrer' target='_blank'" | safe if link.url.startsWith('http')  }}
            >
              {{ link.label }}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {% if section.visual %}
      {% include "partials/visuals/" + section.visual + ".njk" %}
    {% elif section.graphic %}
      <div class="text-image__graphic text-image__graphic--{{ section.graphic }}" aria-hidden="true"></div>
    {% elif section.darkImage %}
      <img
        class="themed-media themed-media--light"
        eleventy:widths="600, 900, 1200, 1600"
        eleventy:formats="avif,webp"
        src="/assets/images/{{ section.image }}"
        alt="{{ section.alt or '' }}"
        sizes="(min-width: 64em) 55rem, 100vw" />
      <img
        class="themed-media themed-media--dark"
        eleventy:widths="600, 900, 1200, 1600"
        eleventy:formats="avif,webp"
        src="/assets/images/{{ section.darkImage }}"
        alt=""
        aria-hidden="true"
        sizes="(min-width: 64em) 55rem, 100vw" />
    {% else %}
      <img
        eleventy:widths="600, 900, 1200, 1600"
        eleventy:formats="avif,webp"
        src="/assets/images/{{ section.image }}"
        alt="{{ section.alt or '' }}"
        sizes="(min-width: 64em) 55rem, 100vw" />
    {% endif %}
  </div>
</section>
